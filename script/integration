#!/usr/bin/env bash
# Runs the integration test against a throwaway registry:2 container.
# Needs Docker and Go 1.26 (with mise: mise exec go@1.26 -- script/integration).
set -euo pipefail
cd "$(dirname "$0")/.."

cid=$(docker run -d --rm -p 127.0.0.1::5000 registry:2)
trap 'docker stop "$cid" >/dev/null' EXIT

port=$(docker port "$cid" 5000/tcp | head -n1 | sed 's/.*://')
export BW_TEST_REGISTRY="127.0.0.1:$port"

for _ in $(seq 1 50); do
  curl -fs "http://$BW_TEST_REGISTRY/v2/" >/dev/null && break
  sleep 0.2
done

go test -count=1 -v -tags integration ./integration/...
